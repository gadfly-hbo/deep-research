  "outline": {
    "title": "森马近3年品牌经营情况研究报告",
    "sections": [
      {
        "id": "s1",
        "title": "品牌档案与近3年定位演变",
        "purpose": "梳理品牌基本面及定位变化，回答品牌定位相关问题",
        "bullets": [
          "森马品牌基础档案：所属集团、创立背景、主营业务（成人休闲装+童装）、品牌发展沿革",
          "近3年品牌定位调整轨迹：目标客群画像变化（如年轻化、家庭消费升级）、品牌形象升级动作、核心价值主张迭代",
          "近3年重大战略事件时间线：品牌焕新、产品定位重塑、代言人/IP合作等关键节点对定位的影响"
        ]
      },
      {
        "id": "s2",
        "title": "产品价格带与定价策略分析",
        "purpose": "回答价格带与定价策略相关问题",
        "bullets": [
          "近3年主要产品价格带分布（如休闲装、童装各价位段占比）及变化趋势",
          "定价策略演变：性价比定位维持、提价/降价动作、折扣促销策略、与竞品的价格差异对比",
          "客单价水平变化：整体客单价及分渠道/分品类客单价趋势，对比品类内外部参照"
        ]
      },
      {
        "id": "s3",
        "title": "全渠道布局与渠道表现",
        "purpose": "覆盖线下门店、电商、社交零售等渠道表现",
        "bullets": [
          "线下渠道：近3年门店总数变化、购物中心/街铺/奥莱店等结构分布、关店与开店策略调整",
          "线上电商渠道：天猫/京东/抖音/拼多多等平台店铺布局、线上销售额占比、爆品打造与电商运营策略",
          "社交零售与新渠道：抖音/小红书/视频号内容种草、私域社群、直播带货等新兴渠道表现与贡献"
        ]
      },
      {
        "id": "s4",
        "title": "竞品格局与对标分析",
        "purpose": "回答竞品识别与竞争格局问题",
        "bullets": [
          "主要竞品识别：成人装板块（优衣库、ZARA、海澜之家等）与童装板块（巴拉巴拉自身、戴维贝拉、安奈儿等）核心竞品清单",
          "竞争格局对标：在目标人群重合度、价格带交叉、渠道布局重叠三个层面的直接与间接竞争关系",
          "近3年竞争态势变化：竞品动作对森马的影响、森马应对策略及市场份额消长"
        ]
      },
      {
        "id": "s5",
        "title": "营销动作与Campaign效果评估",
        "purpose": "梳理代言人、IP联名、营销campaign等营销动作",
        "bullets": [
          "代言人策略：近3年代言人选择与更换逻辑、代言人形象与品牌定位的契合度、代言带来的曝光与销售转化",
          "IP联名合作：核心IP合作清单（动漫、潮牌、艺术家等）、联名产品销售表现、社交声量与品牌焕新效果",
          "大型营销Campaign：年度主题营销节点（如双11、春节、换季）、品效合一效果、私域沉淀与会员增长贡献"
        ]
      },
      {
        "id": "s6",
        "title": "零售业务核心运营指标",
        "purpose": "回答门店坪效、复购率、私域等零售指标问题",
        "bullets": [
          "门店运营效率：近3年门店坪效、人效、店均销售额、坪效同比变化及购物中心门店表现",
          "会员与私域运营：会员总数与增长、新增会员来源、会员复购率、客单价提升策略、私域社群与小程序运营成效",
          "全渠道零售转化：线上线下融合（O2O）情况、库存周转、连带率与品类交叉销售指标"
        ]
      },
      {
        "id": "s7",
        "title": "关键经营业绩与财务表现",
        "purpose": "回答营收、利润、市占率等业绩问题",
        "bullets": [
          "近3年营收与利润：分年度营收、归母净利润、毛利率、净利率走势及品类（成人装/童装）拆分",
          "收入结构变化：线上线下渠道收入占比、品类收入占比、区域收入分布",
          "市占率与行业排名：近3年休闲装/童装细分领域市占率、电商平台排名、行业位次变化"
        ]
      },
      {
        "id": "s8",
        "title": "关键事件与影响因素复盘",
        "purpose": "梳理影响经营的内外部重大事件",
        "bullets": [
          "外部宏观环境冲击：疫情对线下门店与供应链的影响、消费降级/升级趋势、原材料成本波动",
          "内部战略转型事件：数字化转型推进、供应链与库存改革、组织架构调整、品牌焕新里程碑",
          "业务板块动态：童装业务（巴拉巴拉）扩张与表现、海外业务探索、新品牌孵化或子品牌运作"
        ]
      },
      {
        "id": "compare",
        "title": "竞品对比表",
        "purpose": "对比森马与主要竞品的多维度差异",
        "bullets": [
          "定位与价格对比：森马vs核心竞品的目标人群、价格带、品牌调性矩阵",
          "渠道与营销对比：门店数量、电商布局、代言人/IP合作等维度横向对比",
          "经营业绩对比：营收规模、净利率、市占率等关键指标的森马与竞品对比"
        ]
      },
      {
        "id": "oro",
        "title": "机会-风险-假设",
        "purpose": "总结研究发现的机会、风险与待验证假设",
        "bullets": [
          "增长机会：品类延伸机会、渠道结构性机会（直播/奥莱）、品牌升级带来的客单价提升空间",
          "潜在风险：竞品挤压风险、消费趋势变化风险、库存与渠道效率风险、单一品牌依赖风险",
          "关键假设与待验证问题：业绩数据归因假设、消费者认知与定位匹配度假设、可持续增长动力假设"
        ]
      }
    ]
  }
}