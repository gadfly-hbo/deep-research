  "snap:https://finance.sina.com.cn/roll/2024-05-16/doc-inavmvve8535717.shtml": {
    "id": "snap:https://finance.sina.com.cn/roll/2024-05-16/doc-inavmvve8535717.shtml",
    "url": "https://finance.sina.com.cn/roll/2024-05-16/doc-inavmvve8535717.shtml",
