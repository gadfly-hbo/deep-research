  "snap:https://finance.sina.com.cn/tech/roll/2025-08-26/doc-infnhzqc8269967.shtml": {
    "id": "snap:https://finance.sina.com.cn/tech/roll/2025-08-26/doc-infnhzqc8269967.shtml",
    "url": "https://finance.sina.com.cn/tech/roll/2025-08-26/doc-infnhzqc8269967.shtml",
    "title": "\"link\": \"\",",
