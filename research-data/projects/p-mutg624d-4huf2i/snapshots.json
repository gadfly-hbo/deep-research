    "bodyText": "\r\n\t\t\t\t\r\n\t\t\t\t\r\n      \t\t\t\r\n      \t\t\t \t \r\n\t\t\t\t\t  \t\r\n\t\t\t\t\t  \t\r\n\t\t\t\t\t  \t\r\n\t\t\t\t            中国证券报·中证网   2024-05-16 09:09 \r\n\t\t\t\t            \r\n\t\t\t\t            \r\n\t\t\t\t        \r\n\t\t\t\t  \t\r\n\t\t\t\t  \t\r\n\t\t\t\t  \t\r\n       \t\t\t\t\r\n\t\t\t\t\t \r\n\t\t\t",
